00209293
// 0x0014  4012D313   srai x6, x5, 1           // x6 = 20 (40>>1)
4012D313
// 0x0018  00000513   addi x10, x0, 0          // accumulator = 0
00000513
// 0x001C  00100593   addi x11, x0, 1          // counter = 1
00100593
// 0x0020  00500613   addi x12, x0, 5          // limit = 5
00500613
// 0x0024  00B50533   loop:  add  x10, x10, x11  // acc += counter
00B50533
// 0x0028  00158593   addi x11, x11, 1         // counter++
00158593
// 0x002C  00B64463   blt  x12, x11, loop_done // if limit < counter, exit (+8)
00B64463
// 0x0030  FE000AE3   beq  x0, x0, loop        // back to loop (-12)
FE000AE3
// 0x0034  0C800A13   loop_done: addi x20, x0, 200  // base addr
0C800A13
// 0x0038  00AA2023   sw   x10, 0(x20)         // mem[200] = 15
00AA2023
// 0x003C  000A2A83   lw   x21, 0(x20)         // x21 = 15
000A2A83
// 0x0040  00700513   addi x10, x0, 7          // argument for double_it
00700513
// 0x0044  00C000EF   jal  x1, double_it       // call double_it (+12 → PC=0x50)
00C000EF
// 0x0048  00AA2223   sw   x10, 4(x20)         // mem[204] = 14 (result)
00AA2223
// 0x004C  00000063   halt: beq x0, x0, 0      // infinite self-loop
00000063
